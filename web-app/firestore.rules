rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /mats_results/{docId} {
      // Students can only read and write documents whose ID starts with their own UID.
      // The app creates doc IDs as "{uid}_{TEACHERCODE}".
      allow read, write: if request.auth != null
                         && docId.matches(request.auth.uid + '_.*');
    }
    // Block all other collections from unauthenticated access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
